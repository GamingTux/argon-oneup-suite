#!/bin/bash
set -e

if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
    # Restore diverted /usr/bin/pishutdown
    if [ -L /usr/bin/pishutdown ]; then
        rm -f /usr/bin/pishutdown
    fi
    if [ -f /usr/bin/pishutdown.original ]; then
        dpkg-divert --package rpi-pishutdown --remove --rename --divert /usr/bin/pishutdown.original /usr/bin/pishutdown 2>/dev/null || true
    fi
fi

exit 0

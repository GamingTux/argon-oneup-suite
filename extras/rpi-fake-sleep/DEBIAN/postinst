#!/bin/bash
set -e

rm -f /etc/systemd/sleep.conf.d/nosuspend.conf 2>/dev/null || true
if [ -f /etc/rpi-fake-sleep.conf ]; then
    sed -i 's/^SUSPEND_BLUETOOTH_BLOCK=true/SUSPEND_BLUETOOTH_BLOCK=false/' /etc/rpi-fake-sleep.conf 2>/dev/null || true
fi
systemctl daemon-reload 2>/dev/null || true
systemctl enable rpi-fake-sleep-enable.service 2>/dev/null || true
systemctl start rpi-fake-sleep-enable.service 2>/dev/null || true
/usr/bin/rpi-fake-sleep --init-panel 2>/dev/null || true

# Signal logind to reload configuration
systemctl try-reload-or-restart systemd-logind.service 2>/dev/null || true

echo "[rpi-fake-sleep] Raspberry Pi userspace suspend handler installed successfully."
exit 0

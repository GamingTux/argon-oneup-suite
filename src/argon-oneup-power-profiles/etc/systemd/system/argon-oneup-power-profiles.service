[Unit]
Description=Argon ONE UP Laptop Hardware Power Profiles Daemon
Documentation=https://github.com/GamingTux/argon-oneup-suite
Conflicts=power-profiles-daemon.service
Before=plasma-powerdevil.service
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/sbin/argon-oneup-power-profiles
Restart=on-failure
RestartSec=2
KillMode=process

[Install]
WantedBy=multi-user.target
Alias=power-profiles-daemon.service rpi-power-profiles.service argon-power-profiles.service

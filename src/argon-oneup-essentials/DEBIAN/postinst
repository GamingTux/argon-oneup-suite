#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if [ -x /usr/sbin/argon-essentials-apply ]; then
        /usr/sbin/argon-essentials-apply || true
    fi

    # Reload NetworkManager if running so unmanaged eth0 rule takes effect
    if command -v nmcli >/dev/null 2>&1 && systemctl is-active --quiet NetworkManager 2>/dev/null; then
        nmcli general reload 2>/dev/null || true
    fi
fi

exit 0

#!/bin/sh
set -e

CONF_FILE="/etc/argon-oneup.conf"
if [ ! -f "$CONF_FILE" ] && [ -f "/etc/argon-oneup-essentials.conf" ]; then
    CONF_FILE="/etc/argon-oneup-essentials.conf"
fi

ENABLE_ANT2=1
ENABLE_NVME=1
ENABLE_I2C=1
ENABLE_FAN_CURVE=1

if [ -f "$CONF_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONF_FILE"
fi

BOOT_CFG=""
if [ -f /boot/firmware/config.txt ]; then
    BOOT_CFG="/boot/firmware/config.txt"
elif [ -f /boot/config.txt ]; then
    BOOT_CFG="/boot/config.txt"
fi

remove_block() {
    if [ -n "$BOOT_CFG" ] && [ -f "$BOOT_CFG" ]; then
        sed -i '/^# --- BEGIN ARGON-ONEUP-ESSENTIALS ---$/,/^# --- END ARGON-ONEUP-ESSENTIALS ---$/d' "$BOOT_CFG" 2>/dev/null || true
    fi
}

cleanup_obsolete_configs() {
    # Remove obsolete files from legacy versions
    rm -f /etc/modprobe.d/argon-oneup.conf \
          /etc/NetworkManager/conf.d/90-argon-oneup.conf \
          /etc/wireplumber/wireplumber.conf.d/90-argon-oneup.conf \
          /etc/X11/xorg.conf.d/90-argon-oneup.conf \
          /usr/sbin/argononeup-eepromconfig.py \
          /etc/argon-oneup-essentials.conf \
          /boot/firmware/overlays/cm5-disable-ethernet.dtbo \
          /boot/overlays/cm5-disable-ethernet.dtbo \
          /etc/sysctl.d/90-argon-oneup-essentials.conf \
          /etc/sysctl.d/99-z-argon-oneup-essentials.conf \
          /etc/systemd/zram-generator.conf.d/90-argon-oneup.conf \
          /etc/systemd/journald.conf.d/90-argon-oneup.conf \
          /etc/udev/rules.d/90-argon-storage-io.rules \
          /etc/X11/xorg.conf.d/99-v3d.conf \
          /etc/X11/xorg.conf.d/50-touchpad-tapping.conf \
          /etc/pipewire/pipewire.conf.d/10-audio-tuning.conf \
          /etc/modprobe.d/argon-webcam-audio.conf \
          /etc/modprobe.d/argon-hardware-blacklist.conf \
          /etc/wireplumber/wireplumber.conf.d/50-disable-internal-hdmi-audio.conf \
          /etc/NetworkManager/conf.d/90-argon-oneup-wifi.conf \
          /usr/bin/argon-oneup-irq-policy 2>/dev/null || true

    if [ -f /etc/default/irqbalance ] && grep -q "argon-oneup-irq-policy" /etc/default/irqbalance 2>/dev/null; then
        sed -i '/argon-oneup-irq-policy/d' /etc/default/irqbalance 2>/dev/null || true
    fi
}

if [ "${1:-}" = "--remove" ]; then
    remove_block
    exit 0
fi

cleanup_obsolete_configs

if [ -n "$BOOT_CFG" ] && [ -f "$BOOT_CFG" ]; then
    remove_block

    {
        echo "# --- BEGIN ARGON-ONEUP-ESSENTIALS ---"
        echo "[all]"
        if [ "${ENABLE_I2C:-1}" = "1" ]; then
            echo "dtparam=i2c_arm=on"
        fi
        if [ "${ENABLE_NVME:-1}" = "1" ] || [ "${ENABLE_NVME_GEN3:-1}" = "1" ]; then
            echo "dtparam=nvme"
            echo "dtparam=pciex1_gen=3"
        fi
        if [ "${ENABLE_ANT2:-1}" = "1" ]; then
            echo "dtparam=ant2"
        fi
        if [ "${ENABLE_FAN_CURVE:-1}" = "1" ]; then
            echo "dtparam=fan_temp0=40000"
            echo "dtparam=fan_temp0_speed=100"
            echo "dtparam=fan_temp0_hyst=5000"
            echo "dtparam=fan_temp1=50000"
            echo "dtparam=fan_temp1_speed=150"
            echo "dtparam=fan_temp1_hyst=5000"
            echo "dtparam=fan_temp2=60000"
            echo "dtparam=fan_temp2_speed=200"
            echo "dtparam=fan_temp2_hyst=5000"
            echo "dtparam=fan_temp3=70000"
            echo "dtparam=fan_temp3_speed=250"
            echo "dtparam=fan_temp3_hyst=5000"
        fi
        echo "# --- END ARGON-ONEUP-ESSENTIALS ---"
    } >> "$BOOT_CFG"
fi

exit 0

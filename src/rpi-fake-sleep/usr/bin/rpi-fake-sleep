#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""
rpi-fake-sleep — Universal Userspace Standby / Suspend Handler for Raspberry Pi
Provides clean, reliable sleep & wake on Raspberry Pi systems where the kernel
lacks ACPI S3 or stable s2idle.
Uses cgroups v2 app freezing, CPU throttling, display blanking, dynamic battery
loss protection, and instant wake-up via standard Linux input events.
"""

import os
import sys
import glob
import time
import signal
import select
import struct
import fcntl
import subprocess

CONF_FILE = "/etc/rpi-fake-sleep.conf"

EVIOCGSW_4 = 0x8004451b
EVIOCGNAME_256 = (2 << 30) | (256 << 16) | (ord('E') << 8) | 0x06

EVENT_FORMAT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)

def load_config():
    """Loads configuration with sane defaults."""
    cfg = {
        "MAX_BATTERY_LOSS_PERCENT": 10,
        "DISABLE_KEYBOARD_IN_SLEEP": "always",  # "always", "closed", or "never"
        "SUSPEND_WIFI_POWERSAVE": True,
        "SUSPEND_BLUETOOTH_BLOCK": False,
        "ENABLE_AUDIO_AUTOSUSPEND": True,
    }
    if os.path.isfile(CONF_FILE):
        try:
            with open(CONF_FILE, "r") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    if "=" in line:
                        k, v = line.split("=", 1)
                        k, v = k.strip(), v.strip()
                        if k == "MAX_BATTERY_LOSS_PERCENT":
                            cfg[k] = int(v)
                        elif k in ("DISABLE_KEYBOARD_IN_SLEEP", "DISABLE_KEYBOARD_WHEN_CLOSED"):
                            val_lower = v.lower()
                            if val_lower in ("always", "all"):
                                cfg["DISABLE_KEYBOARD_IN_SLEEP"] = "always"
                            elif val_lower in ("closed", "lid"):
                                cfg["DISABLE_KEYBOARD_IN_SLEEP"] = "closed"
                            elif val_lower in ("never", "none"):
                                cfg["DISABLE_KEYBOARD_IN_SLEEP"] = "never"
                            elif val_lower in ("true", "1", "yes"):
                                if k == "DISABLE_KEYBOARD_WHEN_CLOSED":
                                    cfg["DISABLE_KEYBOARD_IN_SLEEP"] = "closed"
                                else:
                                    cfg["DISABLE_KEYBOARD_IN_SLEEP"] = "always"
                            elif val_lower in ("false", "0", "no"):
                                cfg["DISABLE_KEYBOARD_IN_SLEEP"] = "never"
                            else:
                                cfg["DISABLE_KEYBOARD_IN_SLEEP"] = "always"
                        elif k in ("SUSPEND_WIFI_POWERSAVE", "SUSPEND_BLUETOOTH_BLOCK", "ENABLE_AUDIO_AUTOSUSPEND"):
                            cfg[k] = v.lower() in ("true", "1", "yes")
        except Exception:
            pass
    return cfg

def log(msg):
    try:
        subprocess.run(["logger", "-t", "rpi-fake-sleep", msg], check=False)
    except Exception:
        pass

_cached_lid_dev = None

def get_lid_device_path():
    """Finds and caches the /dev/input/event* path for the hardware lid switch."""
    global _cached_lid_dev
    if _cached_lid_dev and os.path.exists(_cached_lid_dev):
        return _cached_lid_dev
    for dev in sorted(glob.glob("/dev/input/event*")):
        try:
            fd = os.open(dev, os.O_RDONLY | os.O_NONBLOCK)
            buf = bytearray(256)
            fcntl.ioctl(fd, EVIOCGNAME_256, buf)
            name = buf.split(b'\x00')[0].decode('utf-8', errors='ignore')
            os.close(fd)
            if "lid" in name.lower():
                _cached_lid_dev = dev
                return dev
        except Exception:
            pass
    return None

def get_lid_state():
    """Returns 'closed', 'open', or 'none' if no lid switch exists."""
    global _cached_lid_dev
    dev = get_lid_device_path()
    if not dev:
        return "none"
    try:
        fd = os.open(dev, os.O_RDONLY | os.O_NONBLOCK)
        sw = bytearray(4)
        fcntl.ioctl(fd, EVIOCGSW_4, sw)
        os.close(fd)
        return "closed" if (sw[0] & 1) else "open"
    except Exception:
        _cached_lid_dev = None
        return "none"

def read_battery_soc():
    """Reads current battery capacity in percent, or None if no battery exists."""
    for p in glob.glob("/sys/class/power_supply/BAT*/capacity"):
        try:
            with open(p, "r") as f:
                return int(f.read().strip())
        except Exception:
            pass
    return None

def is_on_ac():
    """Returns True if mains/AC charger is connected."""
    for p in glob.glob("/sys/class/power_supply/AC*/online") + glob.glob("/sys/class/power_supply/mains/online"):
        try:
            with open(p, "r") as f:
                if f.read().strip() == "1":
                    return True
        except Exception:
            pass
    return False

def set_keyboard_backlight_power(enable: bool):
    """
    Toggles power on the Argon ONE UP internal keyboard USB ports.
    Safely guarded: Exits immediately if no lid switch exists (Desktop Pi).
    """
    if get_lid_state() == "none":
        return

    for p in glob.glob("/sys/bus/usb/devices/1-1:1.0/1-1-port[67]/disable"):
        try:
            with open(p, "w") as f:
                f.write("0" if enable else "1")
        except Exception:
            pass

def get_wifi_power_save() -> bool:
    """Returns True if wlan0 802.11 power saving is currently active."""
    for iw in ["/usr/sbin/iw", "/usr/bin/iw", "iw"]:
        try:
            res = subprocess.run([iw, "dev", "wlan0", "get", "power_save"],
                                 capture_output=True, text=True, check=False)
            if res.returncode == 0:
                return "power save: on" in res.stdout.lower()
        except Exception:
            pass
    return False

def set_wifi_power_save(enable: bool):
    """Toggles 802.11 power saving on wlan0."""
    for iw in ["/usr/sbin/iw", "/usr/bin/iw", "iw"]:
        try:
            subprocess.run([iw, "dev", "wlan0", "set", "power_save", "on" if enable else "off"],
                           check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            break
        except Exception:
            pass

def get_bluetooth_blocked():
    """Checks if bluetooth is currently soft-blocked."""
    for rf in ["/usr/sbin/rfkill", "/usr/bin/rfkill", "rfkill"]:
        try:
            res = subprocess.run([rf, "list", "bluetooth"], capture_output=True, text=True, check=False)
            if res.returncode == 0:
                return "soft blocked: yes" in res.stdout.lower()
        except Exception:
            pass
    return False

def set_bluetooth_power(enable: bool):
    """Enables or soft-blocks bluetooth."""
    for rf in ["/usr/sbin/rfkill", "/usr/bin/rfkill", "rfkill"]:
        try:
            action = "unblock" if enable else "block"
            subprocess.run([rf, action, "bluetooth"],
                           check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            break
        except Exception:
            pass

def set_audio_autosuspend():
    """Enables standard USB runtime autosuspend on USB audio devices without unbinding drivers."""
    try:
        if os.path.isfile("/sys/module/workqueue/parameters/power_efficient"):
            with open("/sys/module/workqueue/parameters/power_efficient", "w") as f:
                f.write("Y")
    except Exception:
        pass

    for audio_intf in glob.glob("/sys/bus/usb/drivers/snd-usb-audio/*:*"):
        try:
            usb_dev = os.path.realpath(os.path.join(audio_intf, ".."))
            for attr, val in (("power/autosuspend_delay_ms", "500"), ("power/control", "auto")):
                p = os.path.join(usb_dev, attr)
                if os.path.isfile(p):
                    with open(p, "w") as f:
                        f.write(val)
        except Exception:
            pass

    # Keep RP1 xHCI (xhci-hcd.*) and DWC2 (*.usb) platform controllers at standard 'on'
    # so empty USB 3.0 / 3.1 ports never lose hotplug detection
    for usb_ctrl in (
        glob.glob("/sys/bus/platform/devices/*.usb/power/control")
        + glob.glob("/sys/bus/platform/devices/xhci-hcd.*/power/control")
    ):
        try:
            with open(usb_ctrl, "w") as f:
                f.write("on")
        except Exception:
            pass

def lock_internal_panel_hotplug():
    """
    Prevents the Argon ONE UP internal BOE 1920x1200 panel (HDMI-A-2) from firing
    a false DRM hotplug disconnect event when the hardware Hall sensor cuts LCD
    controller power on lid close.
    Without this lock, KWin destroys the 1920x1200@1.5x DrmOutput on lid close and
    switches all Wayland clients (Firefox, kscreenlocker_greet, Plasma) to a dummy
    1920x1080@1.0x PlaceholderOutput mid-suspend, causing KWin/Firefox Wayland crashes.
    Safely guarded: Only activates on laptops with a hardware lid switch.
    """
    # Ensure RP1 USB 3.0 xHCI platform controllers stay active for hotplug detection
    for usb_ctrl in (
        glob.glob("/sys/bus/platform/devices/*.usb/power/control")
        + glob.glob("/sys/bus/platform/devices/xhci-hcd.*/power/control")
    ):
        try:
            with open(usb_ctrl, "w") as f:
                f.write("on")
        except Exception:
            pass

    if get_lid_state() == "none":
        return

    edid_fw_dir = "/lib/firmware/edid"
    edid_fw_file = os.path.join(edid_fw_dir, "argon-boe-1920x1200.bin")

    for conn in glob.glob("/sys/class/drm/card*-HDMI-A-2"):
        try:
            edid_path = os.path.join(conn, "edid")
            edid_bytes = b""
            if os.path.isfile(edid_path):
                with open(edid_path, "rb") as f:
                    edid_bytes = f.read()
            if len(edid_bytes) >= 128:
                os.makedirs(edid_fw_dir, exist_ok=True)
                if not os.path.isfile(edid_fw_file) or os.path.getsize(edid_fw_file) != len(edid_bytes):
                    with open(edid_fw_file, "wb") as f:
                        f.write(edid_bytes)
            elif os.path.isfile(edid_fw_file):
                with open(edid_fw_file, "rb") as f:
                    edid_bytes = f.read()

            if len(edid_bytes) >= 128:
                for dbg_edid in glob.glob("/sys/kernel/debug/dri/*/HDMI-A-2/edid_override"):
                    try:
                        with open(dbg_edid, "wb") as f:
                            f.write(edid_bytes)
                    except Exception:
                        pass
                if os.path.isfile("/sys/module/drm/parameters/edid_firmware"):
                    try:
                        with open("/sys/module/drm/parameters/edid_firmware", "w") as f:
                            f.write("HDMI-A-2:edid/argon-boe-1920x1200.bin")
                    except Exception:
                        pass

            if os.path.isfile("/sys/module/vc4/parameters/force_hotplug"):
                try:
                    with open("/sys/module/vc4/parameters/force_hotplug", "w") as f:
                        f.write("2")
                except Exception:
                    pass

            status_path = os.path.join(conn, "status")
            if os.path.isfile(status_path):
                try:
                    with open(status_path, "w") as f:
                        f.write("on")
                except Exception:
                    pass
        except Exception:
            pass

    sync_external_hdmi_hotplug()

def sync_external_hdmi_hotplug():
    """
    Synchronizes external HDMI-A-1 (hdmi0) DRM status with the hardware HDMI_HOTPLUG
    register when vc4.force_hotplug=2 is active on laptops (working around the upstream
    vc4_hdmi_hpd_irq_thread() check that suppresses HPD IRQs on HDMI-A-1 when
    force_hotplug != 0).
    """
    if get_lid_state() == "none":
        return

    try:
        hw_connected = None
        for reg_path in sorted(glob.glob("/sys/kernel/debug/dri/[0-9]*/hdmi0_regs")):
            try:
                with open(reg_path, "r") as f:
                    for line in f:
                        if "HDMI_HOTPLUG" in line:
                            hw_connected = bool(int(line.rsplit("=", 1)[1].strip(), 16) & 1)
                            break
                if hw_connected is not None:
                    break
            except Exception:
                pass

        for st_path in sorted(glob.glob("/sys/class/drm/card*-HDMI-A-1/status")):
            try:
                with open(st_path, "r") as f:
                    drm_connected = (f.read().strip() == "connected")
                if hw_connected is None or hw_connected != drm_connected:
                    with open(st_path, "w") as f:
                        f.write("detect")
            except Exception:
                pass
    except Exception:
        pass

def ensure_powerdevil_lid_config():
    """
    Ensures the system-wide XDG fallback (/etc/xdg/powerdevilrc) does not suppress
    LidAction when HDMI-A-2 (the internal Argon ONE UP panel) stays connected via
    vc4.force_hotplug=2. Never modifies user files in /home.
    """
    if get_lid_state() == "none" or not os.path.isdir("/etc/xdg"):
        return

    pd_file = "/etc/xdg/powerdevilrc"
    try:
        content = ""
        if os.path.isfile(pd_file):
            with open(pd_file, "r") as f:
                content = f.read()

        orig = content
        for sec in ("[AC][SuspendAndShutdown]", "[Battery][SuspendAndShutdown]", "[LowBattery][SuspendAndShutdown]"):
            if sec not in content:
                content = content.rstrip() + f"\n\n{sec}\nInhibitLidActionWhenExternalMonitorPresent=false\nLidAction=1\n"
            elif "InhibitLidActionWhenExternalMonitorPresent" not in content.split(sec, 1)[1].split("\n[", 1)[0]:
                content = content.replace(sec, f"{sec}\nInhibitLidActionWhenExternalMonitorPresent=false")
        if content != orig:
            with open(pd_file, "w") as f:
                f.write(content)
    except Exception:
        pass

def pause_media_players():
    """
    Universally pauses any active MPRIS2 media players (Firefox/YouTube, Chromium,
    Brave, VLC, mpv, Spotify, etc.) across all desktop environments (KDE, Cinnamon,
    GNOME, XFCE, Labwc) using systemd's built-in busctl.
    """
    for bus in glob.glob("/run/user/*/bus"):
        try:
            uid = bus.split("/")[3]
            env_vars = [f"XDG_RUNTIME_DIR=/run/user/{uid}", f"DBUS_SESSION_BUS_ADDRESS=unix:path={bus}"]
            res = subprocess.run(
                ["sudo", "-u", f"#{uid}", "env"] + env_vars + ["busctl", "--user", "--list"],
                capture_output=True, text=True, timeout=2, check=False
            )
            if res.returncode == 0:
                for line in res.stdout.splitlines():
                    parts = line.split()
                    if parts and parts[0].startswith("org.mpris.MediaPlayer2."):
                        subprocess.run(
                            ["sudo", "-u", f"#{uid}", "env"] + env_vars + [
                                "busctl", "--user", "call", parts[0],
                                "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "Pause"
                            ],
                            check=False, timeout=1, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                        )
        except Exception:
            pass

def lock_sessions():
    """Triggers universal desktop screen locking across logind, KDE, Cinnamon, GNOME, and XFCE."""
    try:
        subprocess.run(["loginctl", "lock-sessions"], check=False, timeout=2)
    except Exception:
        pass
    for bus in glob.glob("/run/user/*/bus"):
        try:
            uid = bus.split("/")[3]
            env_vars = [f"XDG_RUNTIME_DIR=/run/user/{uid}", f"DBUS_SESSION_BUS_ADDRESS=unix:path={bus}"]
            for dest, path, iface in (
                ("org.freedesktop.ScreenSaver", "/ScreenSaver", "org.freedesktop.ScreenSaver"),
                ("org.cinnamon.ScreenSaver", "/org/cinnamon/ScreenSaver", "org.cinnamon.ScreenSaver"),
                ("org.gnome.ScreenSaver", "/org/gnome/ScreenSaver", "org.gnome.ScreenSaver"),
            ):
                subprocess.run(
                    ["sudo", "-u", f"#{uid}", "env"] + env_vars + ["busctl", "--user", "call", dest, path, iface, "Lock"],
                    check=False, timeout=1, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                )
        except Exception:
            pass
    time.sleep(0.15)

def get_audio_mute_state():
    """Returns saved mute states for ALSA Master and active pipewire user sessions."""
    state = {"amixer_muted": False, "pipewire_muted": {}}
    try:
        res = subprocess.run(["amixer", "get", "Master"], capture_output=True, text=True, check=False)
        if res.returncode == 0 and "[off]" in res.stdout:
            state["amixer_muted"] = True
    except Exception:
        pass

    for pw in glob.glob("/run/user/*/pipewire-0"):
        try:
            uid = pw.split("/")[3]
            res = subprocess.run(
                ["sudo", "-u", f"#{uid}", "env", f"XDG_RUNTIME_DIR=/run/user/{uid}",
                 "wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"],
                capture_output=True, text=True, check=False
            )
            if res.returncode == 0 and "[MUTED]" in res.stdout:
                state["pipewire_muted"][uid] = True
            else:
                state["pipewire_muted"][uid] = False
        except Exception:
            pass
    return state

def mute_audio():
    try:
        subprocess.run(["amixer", "set", "Master", "mute"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass
    for pw in glob.glob("/run/user/*/pipewire-0"):
        try:
            uid = pw.split("/")[3]
            subprocess.run(
                ["sudo", "-u", f"#{uid}", "env", f"XDG_RUNTIME_DIR=/run/user/{uid}",
                 "wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1"],
                check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            )
        except Exception:
            pass

def restore_audio(saved_audio_state):
    """Restores audio unmute only if it was not originally muted before sleep."""
    pw_states = saved_audio_state.get("pipewire_muted", {})
    for pw in glob.glob("/run/user/*/pipewire-0"):
        try:
            uid = pw.split("/")[3]
            was_muted = pw_states.get(uid, False)
            if not was_muted:
                subprocess.run(
                    ["sudo", "-u", f"#{uid}", "env", f"XDG_RUNTIME_DIR=/run/user/{uid}",
                     "wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0"],
                    check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                )
        except Exception:
            pass
    if not saved_audio_state.get("amixer_muted", False):
        try:
            subprocess.run(["amixer", "set", "Master", "unmute"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

def blank_displays():
    """Saves current brightness and blanks all backlight and DRM displays."""
    saved_brightness = {}
    for bl in glob.glob("/sys/class/backlight/*"):
        b_file = os.path.join(bl, "brightness")
        if os.path.isfile(b_file):
            try:
                with open(b_file, "r") as f:
                    val = int(f.read().strip())
                saved_brightness[b_file] = val
                with open(b_file, "w") as f:
                    f.write("0")
            except Exception:
                pass

    for dpms in glob.glob("/sys/class/drm/card*-*/dpms"):
        try:
            with open(dpms, "w") as f:
                f.write("Off")
        except Exception:
            pass

    # Wayland DPMS (KDE KWin via kscreen-doctor, RPi OS Labwc/Wayfire via wlopm, GNOME/Mutter via busctl)
    for w in glob.glob("/run/user/*/wayland-*"):
        if w.endswith(".lock"):
            continue
        try:
            uid = w.split("/")[3]
            w_name = os.path.basename(w)
            env_vars = ["sudo", "-u", f"#{uid}", "env", f"XDG_RUNTIME_DIR=/run/user/{uid}", f"WAYLAND_DISPLAY={w_name}"]
            if os.path.isfile("/usr/bin/kscreen-doctor"):
                subprocess.run(env_vars + ["QT_QPA_PLATFORM=wayland", "kscreen-doctor", "--dpms", "off"],
                               check=False, timeout=3, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if os.path.isfile("/usr/bin/wlopm"):
                subprocess.run(env_vars + ["wlopm", "--off", "*"],
                               check=False, timeout=2, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            bus = f"/run/user/{uid}/bus"
            if os.path.exists(bus):
                subprocess.run(
                    env_vars + [f"DBUS_SESSION_BUS_ADDRESS=unix:path={bus}",
                                "busctl", "--user", "set-property", "org.gnome.Mutter.DisplayConfig",
                                "/org/gnome/Mutter/DisplayConfig", "org.gnome.Mutter.DisplayConfig", "PowerSaveMode", "i", "3"],
                    check=False, timeout=1, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                )
        except Exception:
            pass

    # X11 DPMS (Cinnamon, XFCE, MATE, LXDE)
    if os.path.isfile("/usr/bin/xset"):
        for xsock in glob.glob("/tmp/.X11-unix/X*"):
            try:
                disp = ":" + os.path.basename(xsock)[1:]
                for bus in glob.glob("/run/user/*/bus"):
                    uid = bus.split("/")[3]
                    pw = os.path.expanduser(f"~#{uid}")
                    xauth = f"/run/user/{uid}/gdm/Xauthority"
                    if not os.path.isfile(xauth):
                        xauth = os.path.join(f"/home/{os.listdir('/home')[0]}" if os.path.isdir("/home") and os.listdir("/home") else "/root", ".Xauthority")
                    subprocess.run(
                        ["sudo", "-u", f"#{uid}", "env", f"DISPLAY={disp}", f"XAUTHORITY={xauth}",
                         "xset", "dpms", "force", "off"],
                        check=False, timeout=2, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                    )
            except Exception:
                pass

    return saved_brightness

def restore_displays(saved_brightness):
    """Restores DRM DPMS and backlight brightness across Wayland and X11."""
    sync_external_hdmi_hotplug()

    # Wayland DPMS (KDE KWin, RPi OS Labwc/Wayfire, GNOME/Mutter)
    for w in glob.glob("/run/user/*/wayland-*"):
        if w.endswith(".lock"):
            continue
        try:
            uid = w.split("/")[3]
            w_name = os.path.basename(w)
            env_vars = ["sudo", "-u", f"#{uid}", "env", f"XDG_RUNTIME_DIR=/run/user/{uid}", f"WAYLAND_DISPLAY={w_name}"]
            if os.path.isfile("/usr/bin/kscreen-doctor"):
                subprocess.run(env_vars + ["QT_QPA_PLATFORM=wayland", "kscreen-doctor", "--dpms", "on"],
                               check=False, timeout=3, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if os.path.isfile("/usr/bin/wlopm"):
                subprocess.run(env_vars + ["wlopm", "--on", "*"],
                               check=False, timeout=2, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            bus = f"/run/user/{uid}/bus"
            if os.path.exists(bus):
                subprocess.run(
                    env_vars + [f"DBUS_SESSION_BUS_ADDRESS=unix:path={bus}",
                                "busctl", "--user", "set-property", "org.gnome.Mutter.DisplayConfig",
                                "/org/gnome/Mutter/DisplayConfig", "org.gnome.Mutter.DisplayConfig", "PowerSaveMode", "i", "0"],
                    check=False, timeout=1, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                )
        except Exception:
            pass

    # X11 DPMS (Cinnamon, XFCE, MATE, LXDE)
    if os.path.isfile("/usr/bin/xset"):
        for xsock in glob.glob("/tmp/.X11-unix/X*"):
            try:
                disp = ":" + os.path.basename(xsock)[1:]
                for bus in glob.glob("/run/user/*/bus"):
                    uid = bus.split("/")[3]
                    xauth = f"/run/user/{uid}/gdm/Xauthority"
                    if not os.path.isfile(xauth):
                        xauth = os.path.join(f"/home/{os.listdir('/home')[0]}" if os.path.isdir("/home") and os.listdir("/home") else "/root", ".Xauthority")
                    subprocess.run(
                        ["sudo", "-u", f"#{uid}", "env", f"DISPLAY={disp}", f"XAUTHORITY={xauth}",
                         "xset", "dpms", "force", "on"],
                        check=False, timeout=2, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                    )
            except Exception:
                pass

    for dpms in glob.glob("/sys/class/drm/card*-*/dpms"):
        try:
            with open(dpms, "w") as f:
                f.write("On")
        except Exception:
            pass

    for b_file, val in saved_brightness.items():
        if os.path.isfile(b_file):
            try:
                with open(b_file, "w") as f:
                    f.write(str(val if val > 0 else 50))
            except Exception:
                pass

def apply_power_saving():
    """Freezes user applications and throttles CPU to minimum clock and single-core WFI."""
    # Allow 250ms for Wayland clients (Firefox, etc.) to finish processing focus-leave,
    # MPRIS pause, and DPMS-off events before freezing app.slice
    time.sleep(0.25)

    # 1. Freeze cgroups v2 user apps (0% CPU for browsers/videos/games during sleep)
    for uid_dir in glob.glob("/sys/fs/cgroup/user.slice/user-*.slice/user@*.service/app.slice"):
        freeze_path = os.path.join(uid_dir, "cgroup.freeze")
        if os.path.exists(freeze_path):
            try:
                with open(freeze_path, "w") as f:
                    f.write("1")
            except Exception:
                pass

    # 2. Throttle CPU governor to powersave and minimum clock
    # Note: On RPi 5 / CM5, cpu0..cpu3/cpufreq are symlinks to shared ../cpufreq/policy0.
    # Deduplicate via realpath so writing to policy0 does not corrupt subsequent reads.
    saved_cpu_state = {}
    seen_policies = set()
    for cpu in sorted(glob.glob("/sys/devices/system/cpu/cpu[0-9]*/cpufreq")):
        real_policy = os.path.realpath(cpu)
        if real_policy in seen_policies:
            continue
        seen_policies.add(real_policy)

        gov_path = os.path.join(real_policy, "scaling_governor")
        min_path = os.path.join(real_policy, "cpuinfo_min_freq")
        max_path = os.path.join(real_policy, "scaling_max_freq")
        maxinfo_path = os.path.join(real_policy, "cpuinfo_max_freq")
        if os.path.isfile(gov_path):
            try:
                gov = "ondemand"
                with open(gov_path, "r") as f:
                    gov = f.read().strip()
                min_freq = None
                if os.path.isfile(min_path):
                    with open(min_path, "r") as f:
                        min_freq = f.read().strip()
                max_freq = None
                if os.path.isfile(max_path):
                    with open(max_path, "r") as f:
                        max_freq = f.read().strip()
                if (not max_freq or max_freq == min_freq) and os.path.isfile(maxinfo_path):
                    with open(maxinfo_path, "r") as f:
                        max_freq = f.read().strip()
                saved_cpu_state[real_policy] = {"gov": gov, "max_freq": max_freq}

                if min_freq and os.path.isfile(max_path):
                    with open(max_path, "w") as f:
                        f.write(min_freq)
                with open(gov_path, "w") as f:
                    f.write("powersave")
            except Exception:
                pass

    # 3. Single-Core WFI Parking (Pin all cgroup slices & kernel workqueues to CPU0)
    # Note: On BCM2712 (RPi 5 / CM5), armstub8-2712.bin implements PSCI_CPU_OFF but lacks
    # PSCI_CPU_ON (offlined cores cannot come back online without a reboot).
    # Instead, we pin cgroups v2 slices and unbound kernel workqueues to CPU0 so
    # CPU1..CPU3 remain permanently in hardware WFI (0 MHz) during standby and resume in <1ms.
    try:
        if os.path.isfile("/sys/fs/cgroup/cgroup.subtree_control"):
            with open("/sys/fs/cgroup/cgroup.subtree_control", "w") as f:
                f.write("+cpuset")
        for cg in ("/sys/fs/cgroup/user.slice", "/sys/fs/cgroup/system.slice", "/sys/fs/cgroup/init.scope"):
            cpuset_file = os.path.join(cg, "cpuset.cpus")
            if os.path.isfile(cpuset_file):
                with open(cpuset_file, "w") as f:
                    f.write("0")
        if os.path.isfile("/sys/devices/virtual/workqueue/cpumask"):
            with open("/sys/devices/virtual/workqueue/cpumask", "w") as f:
                f.write("1")
        os.sched_setaffinity(0, {0})
    except Exception:
        pass

    return saved_cpu_state

def restore_power(saved_cpu_state):
    """Unfreezes applications and restores normal CPU clock."""
    # 0. Restore Multi-Core CPU0..3 scheduling & kernel workqueue affinity
    try:
        all_cpus = "0-3"
        if os.path.isfile("/sys/devices/system/cpu/present"):
            with open("/sys/devices/system/cpu/present", "r") as f:
                all_cpus = f.read().strip() or "0-3"
        for cg in ("/sys/fs/cgroup/user.slice", "/sys/fs/cgroup/system.slice", "/sys/fs/cgroup/init.scope"):
            cpuset_file = os.path.join(cg, "cpuset.cpus")
            if os.path.isfile(cpuset_file):
                with open(cpuset_file, "w") as f:
                    f.write(all_cpus)
        if os.path.isfile("/sys/devices/virtual/workqueue/cpumask"):
            with open("/sys/devices/virtual/workqueue/cpumask", "w") as f:
                f.write("f")
        os.sched_setaffinity(0, {0, 1, 2, 3})
    except Exception:
        pass

    # 1. Unfreeze cgroups v2 user apps
    for uid_dir in glob.glob("/sys/fs/cgroup/user.slice/user-*.slice/user@*.service/app.slice"):
        freeze_path = os.path.join(uid_dir, "cgroup.freeze")
        if os.path.exists(freeze_path):
            try:
                with open(freeze_path, "w") as f:
                    f.write("0")
            except Exception:
                pass

    # 2. Restore CPU clock and governors (deduplicated per cpufreq policy)
    seen_policies = set()
    for cpu in sorted(glob.glob("/sys/devices/system/cpu/cpu[0-9]*/cpufreq")):
        real_policy = os.path.realpath(cpu)
        if real_policy in seen_policies:
            continue
        seen_policies.add(real_policy)

        gov_path = os.path.join(real_policy, "scaling_governor")
        min_path = os.path.join(real_policy, "cpuinfo_min_freq")
        max_path = os.path.join(real_policy, "scaling_max_freq")
        maxinfo_path = os.path.join(real_policy, "cpuinfo_max_freq")
        try:
            state = {}
            if isinstance(saved_cpu_state, dict):
                state = saved_cpu_state.get(real_policy) or saved_cpu_state.get(cpu) or {}
            if isinstance(state, dict):
                gov = state.get("gov", "ondemand")
                top_freq = state.get("max_freq")
            else:
                gov = saved_cpu_state.get(gov_path, "ondemand") if isinstance(saved_cpu_state, dict) else "ondemand"
                top_freq = None

            min_freq = None
            if os.path.isfile(min_path):
                with open(min_path, "r") as f:
                    min_freq = f.read().strip()

            if (not top_freq or top_freq == min_freq) and os.path.isfile(maxinfo_path):
                with open(maxinfo_path, "r") as f:
                    top_freq = f.read().strip()

            if top_freq and os.path.isfile(max_path):
                with open(max_path, "w") as f:
                    f.write(top_freq)

            with open(gov_path, "w") as f:
                f.write(gov)
        except Exception:
            pass

def find_pwmfan_hwmon():
    """Finds the hwmon directory for the Raspberry Pi / Argon PWM fan."""
    for h in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        try:
            name_file = os.path.join(h, "name")
            if os.path.isfile(name_file):
                with open(name_file, "r") as f:
                    if f.read().strip() == "pwmfan":
                        return h
        except Exception:
            pass
    return None

def seed_thermal_cooling_state():
    """
    Re-evaluates and seeds the pwm-fan thermal cooling device state for the current
    SoC temperature. Because BCM2712 thermal zones are interrupt-driven on trip-point
    crossings, restoring pwm1_enable=2 after manual fan-off in sleep can leave the fan
    stuck at state 0 if the temperature is already between two trip points.
    """
    try:
        temp_file = "/sys/class/thermal/thermal_zone0/temp"
        if not os.path.isfile(temp_file):
            return
        with open(temp_file, "r") as f:
            cur_temp = int(f.read().strip())

        active_trips = []
        for tp_type in sorted(glob.glob("/sys/class/thermal/thermal_zone0/trip_point_*_type")):
            try:
                with open(tp_type, "r") as f:
                    t_type = f.read().strip()
                if t_type == "active":
                    tp_temp_file = tp_type.replace("_type", "_temp")
                    with open(tp_temp_file, "r") as f:
                        tp_temp = int(f.read().strip())
                    if tp_temp > 0:
                        active_trips.append(tp_temp)
            except Exception:
                pass

        active_trips.sort()
        if not active_trips:
            active_trips = [45000, 55000, 65000, 75000]

        target_state = 0
        for idx, trip_temp in enumerate(active_trips, start=1):
            if cur_temp >= trip_temp:
                target_state = idx

        for cdev in glob.glob("/sys/class/thermal/cooling_device*"):
            try:
                type_file = os.path.join(cdev, "type")
                if os.path.isfile(type_file):
                    with open(type_file, "r") as f:
                        if "fan" not in f.read().strip().lower():
                            continue
                max_st_file = os.path.join(cdev, "max_state")
                cur_st_file = os.path.join(cdev, "cur_state")
                if os.path.isfile(cur_st_file):
                    max_st = 4
                    if os.path.isfile(max_st_file):
                        with open(max_st_file, "r") as f:
                            max_st = int(f.read().strip())
                    with open(cur_st_file, "w") as f:
                        f.write(str(min(target_state, max_st)))
            except Exception:
                pass
    except Exception:
        pass

def set_fan_sleep_mode(sleep: bool, saved_state=None):
    """
    Stops the PWM fan during sleep for 0 dB silent standby, and restores automatic
    kernel thermal control + seeds cooling_device0 state on wakeup.
    """
    hwmon = find_pwmfan_hwmon()
    if not hwmon:
        return None
    en_file = os.path.join(hwmon, "pwm1_enable")
    pwm_file = os.path.join(hwmon, "pwm1")
    if sleep:
        state = {"hwmon": hwmon, "pwm1_enable": "2", "watchdog_active": False}
        try:
            if os.path.isfile(en_file):
                with open(en_file, "r") as f:
                    state["pwm1_enable"] = f.read().strip() or "2"
                with open(en_file, "w") as f:
                    f.write("1")
            if os.path.isfile(pwm_file):
                with open(pwm_file, "w") as f:
                    f.write("0")
        except Exception:
            pass
        return state
    else:
        try:
            if os.path.isfile(en_file):
                with open(en_file, "w") as f:
                    f.write("2")
            seed_thermal_cooling_state()
        except Exception:
            pass
        return None

def check_fan_thermal_watchdog(saved_fan_state, threshold_mc=68000):
    """
    Built-in thermal safety watchdog during sleep: if SoC temperature exceeds
    threshold_mc (default 68°C) while sleeping, re-enables automatic thermal fan control.
    """
    if not isinstance(saved_fan_state, dict):
        return
    try:
        temp_file = "/sys/class/thermal/thermal_zone0/temp"
        if not os.path.isfile(temp_file):
            return
        with open(temp_file, "r") as f:
            cur_temp = int(f.read().strip())
        hwmon = saved_fan_state.get("hwmon") or find_pwmfan_hwmon()
        if not hwmon:
            return
        en_file = os.path.join(hwmon, "pwm1_enable")
        pwm_file = os.path.join(hwmon, "pwm1")
        if cur_temp >= threshold_mc and not saved_fan_state.get("watchdog_active"):
            log(f"Thermal watchdog: SoC temp {cur_temp / 1000.0:.1f}C >= {threshold_mc / 1000.0:.1f}C in sleep, enabling fan")
            if os.path.isfile(en_file):
                with open(en_file, "w") as f:
                    f.write("2")
            seed_thermal_cooling_state()
            saved_fan_state["watchdog_active"] = True
        elif cur_temp < (threshold_mc - 10000) and saved_fan_state.get("watchdog_active"):
            if os.path.isfile(en_file):
                with open(en_file, "w") as f:
                    f.write("1")
            if os.path.isfile(pwm_file):
                with open(pwm_file, "w") as f:
                    f.write("0")
            saved_fan_state["watchdog_active"] = False
    except Exception:
        pass

def read_interrupt_counts():
    """Returns a dictionary mapping IRQ labels to total interrupt count across all CPUs."""
    irqs = {}
    try:
        with open("/proc/interrupts", "r") as f:
            lines = f.read().splitlines()
        if not lines:
            return irqs
        ncpus = len(lines[0].split())
        for line in lines[1:]:
            parts = line.split()
            if not parts:
                continue
            counts = [int(x) for x in parts[1:1 + ncpus] if x.isdigit()]
            if not counts:
                continue
            desc = " ".join(parts[1 + len(counts):])[-36:] or parts[0].rstrip(":")
            irqs[f"{parts[0].rstrip(':')}({desc})"] = sum(counts)
    except Exception:
        pass
    return irqs

def log_wakeup_report(t_start, soc_start, irqs_start):
    """Logs a concise 1-line standby summary (duration, battery delta & rate, top IRQs/s)."""
    try:
        elapsed_s = max(0.1, time.monotonic() - t_start)
        hours = elapsed_s / 3600.0
        dur_str = f"{hours:.2f}h" if hours >= 0.1 else f"{elapsed_s:.1f}s"

        soc_end = read_battery_soc()
        if soc_start is not None and soc_end is not None:
            diff = soc_end - soc_start
            bat_str = f", battery {soc_start}% -> {soc_end}% ({diff:+d}%"
            if hours >= 0.05 and soc_start > soc_end:
                bat_str += f", {(soc_start - soc_end) / hours:.1f}%/h"
            bat_str += ")"
        else:
            bat_str = ""

        irqs_end = read_interrupt_counts()
        deltas = sorted(
            ((irqs_end[k] - irqs_start.get(k, 0), k) for k in irqs_end),
            reverse=True
        )[:5]
        top_irqs = ", ".join(f"{k} {d / elapsed_s:.1f}/s" for d, k in deltas if d > 0)
        irq_str = f"; top IRQs: {top_irqs}" if top_irqs else ""

        log(f"Standby summary: {dur_str}{bat_str}{irq_str}")
    except Exception:
        pass

def sig_handler(signum, frame):
    raise KeyboardInterrupt()

def print_status():
    cfg = load_config()
    print("=== rpi-fake-sleep status ===")
    print(f"Lid State:         {get_lid_state()}")
    print(f"Battery SOC:       {read_battery_soc()}%")
    print(f"On AC Power:       {is_on_ac()}")
    print(f"Keyboard in Sleep: {cfg.get('DISABLE_KEYBOARD_IN_SLEEP', 'always')}")
    print(f"Max Battery Loss:  {cfg.get('MAX_BATTERY_LOSS_PERCENT', 10)}%")
    print(f"Backlight devices: {glob.glob('/sys/class/backlight/*')}")
    print(f"DRM DPMS devices:  {glob.glob('/sys/class/drm/card*-*/dpms')}")
    print("=============================")

def main():
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ("--help", "-h", "help"):
            print("Usage: rpi-fake-sleep [suspend|status|--init-panel|--help]")
            print("Universal Userspace Sleep & Standby Manager for Raspberry Pi.")
            sys.exit(0)
        elif arg == "status":
            print_status()
            sys.exit(0)
        elif arg in ("--init-panel", "init-panel"):
            lock_internal_panel_hotplug()
            ensure_powerdevil_lid_config()
            sys.exit(0)

    signal.signal(signal.SIGTERM, sig_handler)
    signal.signal(signal.SIGINT, sig_handler)

    lock_internal_panel_hotplug()
    ensure_powerdevil_lid_config()

    cfg = load_config()
    initial_lid = get_lid_state()
    lid_was_closed = (initial_lid == "closed")
    initial_soc = read_battery_soc()
    on_ac_init = is_on_ac()

    log(f"Entering sleep (lid: {initial_lid}, battery: {initial_soc}%, AC: {on_ac_init})")

    saved_bt_blocked = get_bluetooth_blocked()
    saved_wifi_powersave = get_wifi_power_save()
    saved_audio_mute = get_audio_mute_state()

    # 1. Pause active media players (YouTube, etc.) & mute sound
    pause_media_players()
    mute_audio()

    # 2. Lock screen
    lock_sessions()

    # 3. Blank displays
    saved_brightness = blank_displays()

    # 4. Freeze apps & throttle CPU
    saved_cpu_state = apply_power_saving()

    # 5. Radio, Audio & Fan power savings
    if cfg.get("ENABLE_AUDIO_AUTOSUSPEND", True):
        set_audio_autosuspend()
    if cfg.get("SUSPEND_WIFI_POWERSAVE", True):
        set_wifi_power_save(True)
    if cfg.get("SUSPEND_BLUETOOTH_BLOCK", False) and not saved_bt_blocked:
        set_bluetooth_power(False)
    saved_fan_state = set_fan_sleep_mode(True)

    # 6. Turn off keyboard backlight & USB power in sleep if configured
    kbd_mode = cfg.get("DISABLE_KEYBOARD_IN_SLEEP", "always")
    if kbd_mode == "always" or (kbd_mode == "closed" and lid_was_closed):
        log(f"Powering off internal keyboard in sleep (mode: {kbd_mode}, lid: {initial_lid})")
        set_keyboard_backlight_power(enable=False)

    # 7. Open input devices and wait via epoll (0% CPU)
    epoll = select.epoll()
    open_fds = []

    for dev in glob.glob("/dev/input/event*"):
        try:
            fd = os.open(dev, os.O_RDONLY | os.O_NONBLOCK)
            epoll.register(fd, select.EPOLLIN)
            open_fds.append(fd)
        except Exception:
            pass

    last_battery_check = time.time()
    sleep_start_ts = time.monotonic()
    initial_irqs = read_interrupt_counts()

    try:
        while True:
            # Poll every 0.25s for instant responsiveness
            events = epoll.poll(timeout=0.25)

            # Check if lid state transitioned to open (fast 1s poll check)
            if lid_was_closed and get_lid_state() == "open":
                log("Lid opened (poll check) -> waking up")
                break

            # Periodic check for thermal safety & battery loss while sleeping (every 30s)
            now = time.time()
            if (now - last_battery_check) >= 30.0:
                last_battery_check = now
                check_fan_thermal_watchdog(saved_fan_state)

                # Dynamic battery loss protection (only when closed on battery)
                if lid_was_closed and not is_on_ac():
                    max_loss = cfg["MAX_BATTERY_LOSS_PERCENT"]
                    if max_loss > 0 and initial_soc is not None:
                        curr_soc = read_battery_soc()
                        if curr_soc is not None:
                            loss = initial_soc - curr_soc
                            if loss >= max_loss:
                                log(f"Standby battery loss reached {loss}% (limit {max_loss}%): powering off cleanly")
                                subprocess.run(["systemctl", "poweroff"], check=False)
                                break

            if not events:
                continue

            wake = False
            for fd, event in events:
                # Handle disconnected devices (e.g. USB keyboard disconnected when power was cut)
                if event & (select.EPOLLHUP | select.EPOLLERR):
                    try:
                        epoll.unregister(fd)
                        os.close(fd)
                        if fd in open_fds:
                            open_fds.remove(fd)
                    except Exception:
                        pass
                    continue

                try:
                    data = os.read(fd, EVENT_SIZE * 16)
                    if not data:
                        try:
                            epoll.unregister(fd)
                            os.close(fd)
                            if fd in open_fds:
                                open_fds.remove(fd)
                        except Exception:
                            pass
                        continue

                    for i in range(0, len(data), EVENT_SIZE):
                        chunk = data[i:i+EVENT_SIZE]
                        if len(chunk) < EVENT_SIZE:
                            continue
                        sec, usec, ev_type, ev_code, ev_val = struct.unpack(EVENT_FORMAT, chunk)

                        # EV_SW (5), SW_LID (0) -> 0 = OPEN
                        if ev_type == 5 and ev_code == 0:
                            if ev_val == 0:
                                log("Lid opened -> waking up")
                                wake = True
                                break
                            elif ev_val == 1:
                                lid_was_closed = True
                                if kbd_mode in ("always", "closed"):
                                    set_keyboard_backlight_power(enable=False)

                        # EV_KEY (1) -> 1 = key down
                        elif ev_type == 1 and ev_val == 1:
                            log(f"Key press detected (code {ev_code}) -> waking up")
                            wake = True
                            break

                        # Mouse / Touchpad (EV_REL=2, EV_ABS=3) only wakes if lid was open
                        elif ev_type in (2, 3) and not lid_was_closed:
                            log("Pointer motion detected -> waking up")
                            wake = True
                            break
                except Exception:
                    pass

            if wake:
                break
    except KeyboardInterrupt:
        log("Sleep interrupted by signal -> waking up")
    finally:
        for fd in open_fds:
            try:
                epoll.unregister(fd)
                os.close(fd)
            except Exception:
                pass
        epoll.close()

        # 1. Unfreeze user apps and restore multi-core CPU clock FIRST so Wayland
        # clients (Firefox, etc.) are awake BEFORE KWin turns display DPMS back on
        restore_power(saved_cpu_state)
        set_fan_sleep_mode(False, saved_fan_state)
        time.sleep(0.05)

        # 2. Restore displays (DPMS On & brightness)
        restore_displays(saved_brightness)

        # 3. Re-enable keyboard power, radios, and audio on resume
        set_keyboard_backlight_power(enable=True)
        if cfg.get("SUSPEND_BLUETOOTH_BLOCK", False) and not saved_bt_blocked:
            set_bluetooth_power(True)
        if cfg.get("SUSPEND_WIFI_POWERSAVE", True):
            set_wifi_power_save(saved_wifi_powersave)
        restore_audio(saved_audio_mute)
        log_wakeup_report(sleep_start_ts, initial_soc, initial_irqs)
        log("Wakeup complete, normal power & display restored")

    sys.exit(0)

if __name__ == "__main__":
    main()

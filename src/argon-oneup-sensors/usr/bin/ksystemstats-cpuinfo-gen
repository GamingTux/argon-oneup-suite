#!/bin/bash
# ksystemstats-cpuinfo-gen — generate an ARM-compatible /proc/cpuinfo for ksystemstats
#
# ksystemstats_plugin_cpu.so reads /proc/cpuinfo expecting x86 format: a
# "cpu MHz" field inside each processor block. On ARM this field is absent,
# and trailing Pi-specific fields (Revision/Serial/Model) cause the inner loop
# to spin forever at EOF (KDE bug #493093).
#
# This script writes a corrected cpuinfo — cpu MHz injected into each block,
# trailing non-CPU fields stripped — atomically to the path given as $1.
set -eu

OUTPUT="${1:?output path required}"
TMP_OUT="${OUTPUT}.tmp.$$"

umask 0077
trap 'rm -f "$TMP_OUT"' EXIT

{
    while IFS= read -r line; do
        [[ "$line" =~ ^(Revision|Serial|Model) ]] && continue
        printf '%s\n' "$line"
        if [[ "$line" =~ ^processor[[:space:]]*:[[:space:]]*([0-9]+) ]]; then
            cpu="${BASH_REMATCH[1]}"
            freq=2400000
            freq_file="/sys/devices/system/cpu/cpu${cpu}/cpufreq/scaling_cur_freq"
            if [ -r "$freq_file" ]; then
                read -r freq < "$freq_file" 2>/dev/null || freq=2400000
            fi
            [[ "$freq" =~ ^[0-9]+$ ]] || freq=2400000
            printf "cpu MHz\t\t: %d.%03d\n" $((freq / 1000)) $((freq % 1000))
        fi
    done < /proc/cpuinfo
} > "$TMP_OUT"

mv -f "$TMP_OUT" "$OUTPUT"

#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""
ksystemstats-rpi5-fix — Patches ksystemstats_plugin_cpu.so to map cpu_thermal on Raspberry Pi 5.
"""
import os
import shutil
import struct
import sys

restore_mode = "--restore" in sys.argv[1:]
args = [a for a in sys.argv[1:] if not a.startswith("-")]
root = args[0] if args and os.path.isdir(args[0]) else ""

cpu_path = (
    os.path.join(root, "usr/lib/aarch64-linux-gnu/qt6/plugins/ksystemstats/ksystemstats_plugin_cpu.so")
    if root
    else "/usr/lib/aarch64-linux-gnu/qt6/plugins/ksystemstats/ksystemstats_plugin_cpu.so"
)
stamp_dir = os.path.join(root, "var/lib/argon-oneup-sensors") if root else "/var/lib/argon-oneup-sensors"
stamp_file = os.path.join(stamp_dir, "ksystemstats.stamp")
backup_file = os.path.join(stamp_dir, "ksystemstats_plugin_cpu.so.orig")

if restore_mode:
    if os.path.isfile(backup_file) and os.path.isfile(cpu_path):
        try:
            tmp_path = cpu_path + ".restore.tmp"
            shutil.copy2(backup_file, tmp_path)
            os.chmod(tmp_path, 0o644)
            os.replace(tmp_path, cpu_path)
            print("[argon-oneup-sensors] Restored original ksystemstats_plugin_cpu.so")
        except Exception as e:
            print(f"[argon-oneup-sensors] Warning: could not restore ksystemstats_plugin_cpu.so: {e}", file=sys.stderr)
    sys.exit(0)

if os.path.isfile(cpu_path):
    # Fast path: check stamp to avoid redundant file I/O on unrelated apt invocations
    try:
        cur_mtime = str(int(os.path.getmtime(cpu_path)))
        if os.path.isfile(stamp_file):
            with open(stamp_file, "r") as sf:
                if sf.read().strip() == cur_mtime:
                    sys.exit(0)
    except Exception:
        pass

    try:
        with open(cpu_path, "rb") as f:
            data = bytearray(f.read())
        changed = False
        if len(data) >= 0x12000 and data[0x11a80:0x11a87] == b"Serial\x00":
            insn_bb98 = 0xb4000001 | (((-117) & 0x7ffff) << 5)
            if struct.unpack_from("<I", data, 0xbb98)[0] != insn_bb98:
                try:
                    os.makedirs(stamp_dir, exist_ok=True)
                    shutil.copy2(cpu_path, backup_file)
                except Exception:
                    pass
                struct.pack_into("<I", data, 0xbb98, insn_bb98)
                struct.pack_into("<I", data, 0xbba8, 0x54000001 | (((-121) & 0x7ffff) << 5))
                struct.pack_into("<I", data, 0xbbb4, 0x14000000 | ((-124) & 0x3ffffff))
                struct.pack_into("<I", data, 0xb6d8, 0xb9000bff)
                struct.pack_into("<I", data, 0xb6dc, 0xb90013ff)
                data[0x11a60:0x11a70] = b"cpu_thermal\x00\x00\x00\x00\x00"
                offset_b54c = (0x9820 - 0xb54c) >> 2
                struct.pack_into("<I", data, 0xb54c, 0x94000000 | (offset_b54c & 0x3ffffff))
                changed = True
        if changed:
            tmp_path = cpu_path + ".tmp"
            with open(tmp_path, "wb") as f:
                f.write(data)
            os.chmod(tmp_path, 0o644)
            os.replace(tmp_path, cpu_path)
            print("[argon-oneup-sensors] Successfully patched ksystemstats_plugin_cpu.so for cpu_thermal")

        # Update stamp
        try:
            os.makedirs(stamp_dir, exist_ok=True)
            new_mtime = str(int(os.path.getmtime(cpu_path)))
            with open(stamp_file, "w") as sf:
                sf.write(new_mtime)
        except Exception:
            pass
    except Exception as e:
        print(f"[argon-oneup-sensors] Warning: could not patch ksystemstats_plugin_cpu: {e}", file=sys.stderr)

"""
rpi-suspend — Universal Userspace Suspend, Standby & Clamshell Manager for Raspberry Pi
Provides native low-power sleep, instant <1ms wake, and docked clamshell mode on
Raspberry Pi 4 / 5 & CM4 / CM5 systems where platform firmware lacks ACPI S3.
"""

import os
import re
import sys
import pwd
import glob
import time
import signal
import select
import struct
import syslog
import fcntl
import fnmatch
import subprocess

CONF_FILE = "/etc/rpi-suspend.conf"
LEGACY_CONF_FILE = "/etc/rpi-fake-sleep.conf"
CONF_DIR = "/etc/rpi-suspend.conf.d"
PROFILES_DIR = "/usr/share/rpi-suspend/profiles"
HOOKS_DIRS = ("/usr/lib/rpi-suspend/hooks.d", "/etc/rpi-suspend/hooks.d")
ACTIVE_LOCK_FILE = "/run/rpi-suspend.active"

EVIOCGSW_4 = 0x8004451b
EVIOCGNAME_256 = (2 << 30) | (256 << 16) | (ord('E') << 8) | 0x06

EVENT_FORMAT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)

POWER_KEY_CODES = (116, 142, 143)  # KEY_POWER, KEY_SLEEP, KEY_WAKEUP

BOOL_KEYS = (
    # Mode 1: Deep Standby / Suspend (SLEEP_*)
    "SLEEP_LOCK_SCREEN",
    "SLEEP_PAUSE_MEDIA",
    "SLEEP_MUTE_AUDIO",

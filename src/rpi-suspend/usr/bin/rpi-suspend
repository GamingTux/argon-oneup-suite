    "WAKE_ON_KEYBOARD",
    "WAKE_ON_MOUSE_CLICK",
    "WAKE_ON_MOUSE_MOVE",
    # Mode 4: Safety Watchdogs & Telemetry (WATCHDOG_* / LOG_*)
    "WATCHDOG_THERMAL_ENABLE",
    "WATCHDOG_BATTERY_ENABLE",
    "LOG_WAKEUP_SUMMARY",
)

INT_KEYS = (
    "WATCHDOG_THERMAL_TEMP_MC",
    "WATCHDOG_MAX_BATTERY_LOSS_PERCENT",
)

STR_KEYS = (
    "PROFILE",
    "INTERNAL_DISPLAY",
    "CUSTOM_POWER_CUT_PATHS",
    "CUSTOM_USBHID_UNBIND",
)

LEGACY_KEY_MAP = {
    "ENABLE_LOCK_SCREEN": "SLEEP_LOCK_SCREEN",
    "ENABLE_MPRIS_PAUSE": "SLEEP_PAUSE_MEDIA",
    "ENABLE_AUDIO_MUTE": "SLEEP_MUTE_AUDIO",
    "ENABLE_DISPLAY_DPMS": "SLEEP_BLANK_DISPLAYS",
    "ENABLE_KBD_BACKLIGHT": "SLEEP_DIM_KBD_BACKLIGHT",
    "ENABLE_CGROUP_FREEZE": "SLEEP_FREEZE_PROCESSES",
    "ENABLE_CPU_POWERSAVE": "SLEEP_CPU_POWERSAVE",
    "ENABLE_CPU_PARKING": "SLEEP_CPU_PARKING",
    "ENABLE_AUDIO_AUTOSUSPEND": "SLEEP_USB_AUTOSUSPEND",
    "SUSPEND_WIFI_POWERSAVE": "SLEEP_WIFI_POWERSAVE",
    "SUSPEND_BLUETOOTH_BLOCK": "SLEEP_BLUETOOTH_RFKILL",
    "ENABLE_FAN_CONTROL": "SLEEP_FAN_SILENT",
    "ENABLE_CLAMSHELL_MODE": "CLAMSHELL_ENABLE",
    "WAKE_ON_LID": "WAKE_ON_LID_OPEN",
    "WAKE_ON_MOUSE": "WAKE_ON_MOUSE_CLICK",
    "FAN_WATCHDOG_TEMP_MC": "WATCHDOG_THERMAL_TEMP_MC",
    "MAX_BATTERY_LOSS_PERCENT": "WATCHDOG_MAX_BATTERY_LOSS_PERCENT",
}


def default_config():
    return {
        "PROFILE": "generic",
        # --- Mode 1: Deep Standby / Suspend (SLEEP_*) ---
        "SLEEP_LOCK_SCREEN": True,
        "SLEEP_PAUSE_MEDIA": True,
        "SLEEP_MUTE_AUDIO": True,
        "SLEEP_BLANK_DISPLAYS": True,
        "SLEEP_DIM_BACKLIGHT": True,
        "SLEEP_DIM_KBD_BACKLIGHT": True,
        "SLEEP_FREEZE_PROCESSES": True,
        "SLEEP_CPU_POWERSAVE": True,
        "SLEEP_CPU_PARKING": True,
        "SLEEP_WORKQUEUE_POWERSAVE": True,
        "SLEEP_USB_AUTOSUSPEND": True,
        "SLEEP_WIFI_POWERSAVE": True,
        "SLEEP_WIFI_RFKILL": False,
        "SLEEP_BLUETOOTH_RFKILL": False,
        "SLEEP_FAN_SILENT": True,
        "SLEEP_CUSTOM_POWER_CUTS": True,
        "SLEEP_RUN_HOOKS": True,
        # --- Mode 2: Docked Clamshell Mode (CLAMSHELL_*) ---
        "CLAMSHELL_ENABLE": True,
        "CLAMSHELL_SUSPEND_UNDOCKED": True,
        "CLAMSHELL_BLANK_INTERNAL_DISPLAY": True,
        "CLAMSHELL_DIM_INTERNAL_BACKLIGHT": True,
        "CLAMSHELL_DIM_KBD_BACKLIGHT": True,
        "CLAMSHELL_DISABLE_INTERNAL_INPUT": True,
        "CLAMSHELL_LOCK_ON_CLOSE": False,
        "CLAMSHELL_RUN_HOOKS": True,
        # --- Mode 3: Wakeup Sources (WAKE_*) ---
        "WAKE_ON_LID_OPEN": True,
        "WAKE_ON_POWER_BUTTON": True,
        "WAKE_ON_KEYBOARD": True,
        "WAKE_ON_MOUSE_CLICK": True,
        "WAKE_ON_MOUSE_MOVE": False,
        # --- Mode 4: Watchdogs & Telemetry ---
        "WATCHDOG_THERMAL_ENABLE": True,

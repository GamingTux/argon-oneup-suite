    "SLEEP_CPU_PARKING",
    "SLEEP_WORKQUEUE_POWERSAVE",
    "SLEEP_USB_AUTOSUSPEND",
    "SLEEP_WIFI_POWERSAVE",
    "SLEEP_WIFI_RFKILL",
    "SLEEP_BLUETOOTH_RFKILL",
    "SLEEP_FAN_SILENT",
    "SLEEP_CUSTOM_POWER_CUTS",
    "SLEEP_RUN_HOOKS",
    # Mode 2: Docked Clamshell Mode (CLAMSHELL_*)
    "CLAMSHELL_ENABLE",
    "CLAMSHELL_SUSPEND_UNDOCKED",

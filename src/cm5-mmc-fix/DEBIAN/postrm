#!/bin/bash
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    for d in /boot/firmware /boot; do
        rm -f "$d/overlays/cm5-sdcard-fast.dtbo" 2>/dev/null || true
        if [ -f "$d/config.txt" ] && grep -q "^[[:space:]]*dtoverlay=cm5-sdcard-fast" "$d/config.txt"; then
            sed -i '/^[[:space:]]*dtoverlay=cm5-sdcard-fast/d' "$d/config.txt" 2>/dev/null || true
            echo "[cm5-mmc-fix] Removed dtoverlay=cm5-sdcard-fast from $d/config.txt"
        fi
    done
fi
exit 0

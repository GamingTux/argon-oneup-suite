#!/bin/bash
set -e

CONFIG=""
for f in /boot/firmware/config.txt /boot/config.txt; do
    if [ -f "$f" ]; then
        CONFIG="$f"
        break
    fi
done

if [ -n "$CONFIG" ]; then
    if ! grep -q "^[[:space:]]*dtparam=i2c_arm=on" "$CONFIG"; then
        echo "dtparam=i2c_arm=on" >> "$CONFIG"
        echo "[argon-oneup-backlight] Added dtparam=i2c_arm=on to $CONFIG"
    fi
fi

getent group i2c >/dev/null || groupadd -r i2c 2>/dev/null || true

systemctl daemon-reload 2>/dev/null || true
systemctl enable argon-backlight.service 2>/dev/null || true
udevadm control --reload-rules 2>/dev/null || true
/usr/sbin/argon-backlight-init 2>/dev/null || true

echo "[argon-oneup-backlight] Backlight driver installed and initialized successfully!"
exit 0
